{
  "name": "@ironbee-ai/gamer",
  "version": "0.1.0",
  "description": "Plays browser games live with a fast decision engine (TypeSafe Jev): a per-game profile turns the page into a small state, Jev picks every move, and an LLM trains the profile from the games it plays",
  "homepage": "https://github.com/ironbee-ai/ironbee-gamer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironbee-ai/ironbee-gamer.git"
  },
  "bugs": {
    "url": "https://github.com/ironbee-ai/ironbee-gamer/issues"
  },
  "keywords": [
    "game-playing",
    "ai-agent",
    "browser-games",
    "playwright",
    "ironbee",
    "typesafe",
    "jev"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ibgamer": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "library",
    "laya/*.py",
    "laya/requirements.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js && tsc --emitDeclarationOnly && node scripts/build-devtools-plugin.js && node scripts/copy-assets.js",
    "dev": "ts-node src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "ui": "node dist/cli/main.js ui",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "author": "IronBee",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ironbee-ai/devtools": "^0.50.0",
    "commander": "^12.1.0",
    "undici": "^7.30.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "playwright-core": "^1.62.1",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
